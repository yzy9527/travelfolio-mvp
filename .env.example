# Copy to .env; chmod 600 .env. Never commit, share, or include .env in a ZIP.
# Required bootstrap administrator password: run `openssl rand -hex 32`.
# This is passed only to PostgreSQL, never to the API container.
POSTGRES_PASSWORD=
# Required SEPARATE app database password: run `openssl rand -hex 32` again.
# Use hexadecimal/URL-safe characters because Compose includes this in a URL.
APP_DB_PASSWORD=
# Required: run `openssl rand -base64 32`; exactly 32 decoded bytes.
# Preserve this secret for as long as you need to decrypt stored BYOK keys.
KEY_ENCRYPTION_SECRET=

# LOCAL DEVELOPMENT ONLY. Origin must exactly match your browser URL, no slash.
# For public deployment: APP_ORIGIN=https://your-host and SESSION_COOKIE_SECURE=true.
APP_ORIGIN=http://localhost:7875
SESSION_COOKIE_SECURE=false
WEB_PORT=7875

# Disabled unless an operator deliberately enables synthetic, non-live examples.
DEMO_ENABLED=false
# Required for live full-handbook research. Worker-only shared Brave key; search may incur charges.
BRAVE_SEARCH_API_KEY=
# API capability flag; set true only after configuring the worker key above.
BRAVE_SEARCH_CONFIGURED=false
# Exact official hosts verified by the operator (comma separated), never model-controlled.
# Without this allowlist, sources are unclassified and official image acquisition stays pending.
RESEARCH_OFFICIAL_HOSTS=
# Worker DNS: cloudflare or google use pinned trusted DoH; system uses OS DNS only
# where it returns real public IPs. No arbitrary DNS URL or IP can be configured.
WORKER_DNS_MODE=cloudflare

# For running the API directly, export DATABASE_URL, PORT, and the settings above.
# Docker Compose constructs DATABASE_URL using its private postgres service.
# DATABASE_URL=postgresql://travelfolio:URL_SAFE_PASSWORD@127.0.0.1:5432/travelfolio
# PORT=3000


# Direct Worker runtime: absolute trusted sandbox-capable Chromium executable.
# Browser-enabled Docker target already installs and sets this.
# CHROMIUM_PATH=/usr/bin/chromium
