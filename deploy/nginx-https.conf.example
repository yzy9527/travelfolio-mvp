# Host-level Nginx example; replace example.invalid and certificate paths.
# No certificates, live hostnames or account credentials are shipped.
# Install this only after obtaining a valid certificate for your own hostname.
# The Compose web port remains bound to 127.0.0.1:7875.
server {
    listen 80;
    server_name example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name example.invalid;
    ssl_certificate /etc/letsencrypt/live/example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 128k;
    access_log off;

    # Enable only after validating HTTPS and certificate renewal for this host.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:7875;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
